def cell_width(ch: str) -> int:
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def text_width(s: str) -> int:
    return sum(cell_width(c) for c in s)


def wrap(text: str, width: int) -> list:
    width = max(width, 8)
    out = []
    for para in text.split("\n"):
        line, used = "", 0
        for word in re.split(r"(\s+)", para):
            w = text_width(word)
            if used + w <= width:
                line, used = line + word, used + w
                continue
            if line.strip():
                out.append(line.rstrip())
            word = word.lstrip() if word.isspace() else word
            line, used = "", 0
            while text_width(word) > width:  # hard-break very long tokens
                cut, cw = "", 0
                for ch in word:
                    if cw + cell_width(ch) > width:
                        break
                    cut, cw = cut + ch, cw + cell_width(ch)
                out.append(cut)
                word = word[len(cut):]
            line, used = word, text_width(word)
        out.append(line.rstrip())
    return out or [""]


class UI:
    def __init__(self, scr):
        import curses

        self.c = curses
        self.scr = scr
        self.entries: list = []
        self.statuses: dict = {}
        self.roster: dict = {}
        self.boxes_online: dict = {}
        self.offset = 0
        self.partial = ""
        self.buf: list = []
        self.cur = 0
        self.history: list = []
        self.hist_i = 0
        self.scroll = 0
        self.flash = ""
        self.flash_until = 0.0
        self.comp = None
        self.router_up = None
        self.router_checked = 0.0
        self.hub = os.path.exists(HUB_MARKER)
        curses.curs_set(1)
        scr.keypad(True)
        scr.timeout(250)
        curses.use_default_colors()
        palette = [curses.COLOR_GREEN, curses.COLOR_CYAN, curses.COLOR_YELLOW,
                   curses.COLOR_MAGENTA, curses.COLOR_BLUE, curses.COLOR_RED]
        for i, color in enumerate(palette, start=1):
            curses.init_pair(i, color, -1)
        self.HUMAN = curses.color_pair(1) | curses.A_BOLD
        self.SYS = curses.color_pair(3) | curses.A_DIM
        self.MENTION = curses.color_pair(4) | curses.A_BOLD
        self.DIM = curses.A_DIM
        self.agent_colors = [curses.color_pair(2) | curses.A_BOLD,
                             curses.color_pair(5) | curses.A_BOLD,
                             curses.color_pair(6) | curses.A_BOLD]

    # data -----------------------------------------------------------------
    def poll(self) -> bool:
        try:
            size = os.path.getsize(LOG)
        except FileNotFoundError:
            return False
        if size < self.offset:  # mirror rewrote the file
            self.entries, self.statuses, self.offset, self.partial = [], {}, 0, ""
        if size == self.offset:
            return False
        with open(LOG, "rb") as fh:
            fh.seek(self.offset)
            chunk = fh.read()
        self.offset += len(chunk)
        text = self.partial + chunk.decode("utf-8", "replace")
        lines = text.split("\n")
        self.partial = lines.pop()
        for line in lines:
            obj = parse_line(line)
            if not obj:
                continue
            kind = obj.get("kind")
            if kind in ("msg", "sys"):
                self.entries.append(obj)
            elif kind == "status":
                self.statuses.setdefault(obj.get("ref"), {})[obj.get("to")] = obj.get("state")
            elif kind == "roster":
                self.roster = {a["addr"]: a for a in obj.get("agents", [])}
                self.boxes_online = obj.get("boxes") or {}
        return True

    def check_router(self) -> None:
        if not self.hub or time.time() - self.router_checked < 2:
            return
        self.router_checked = time.time()
        self.router_up = router_running()

    # rendering ------------------------------------------------------------
    def agent_attr(self, addr: str):
        return self.agent_colors[sum(map(ord, addr)) % len(self.agent_colors)]

    def segments(self, text: str, base):
        """Split text into (chunk, attr) with @mentions highlighted."""
        out, pos = [], 0
        for m in MENTION.finditer(text):
            if m.start() > pos:
                out.append((text[pos:m.start()], base))
            out.append((m.group(0), self.MENTION))
            pos = m.end()
        if pos < len(text):
            out.append((text[pos:], base))
        return out

    def build_lines(self, width: int) -> list:
        rows = []
        for obj in self.entries:
            ts = hhmm(obj.get("ts"))
            if obj["kind"] == "sys":
                for i, part in enumerate(wrap(obj.get("text", ""), width - 8)):
                    rows.append([((ts if i == 0 else "     ") + " · ", self.SYS), (part, self.SYS)])
                continue
            sender = obj.get("from", "?")
            who = display_addr(sender, self.roster)
            attr = self.HUMAN if sender == HUMAN else self.agent_attr(sender)
            head = f"{ts} "
            body = wrap(obj.get("text", ""), width - 8)
            rows.append([(head, self.DIM), (who, attr)])
            for part in body:
                rows.append([("      ", 0)] + self.segments(part, 0))
            states = self.statuses.get(obj.get("id"), {})
            targets = [t for t in obj.get("to", []) if t != HUMAN]
            if targets:
                marks = "  ".join(
                    f"{display_addr(t, self.roster)} {DELIVERY_GLYPH.get(states.get(t), '·')}"
                    for t in targets
                )
                rows.append([("      → " + marks, self.DIM)])
        return rows

    def put(self, y: int, x: int, text: str, attr=0, limit=None) -> int:
        h, w = self.scr.getmaxyx()
        limit = w - x if limit is None else min(limit, w - x)
        out, used = "", 0
        for ch in text:
            cw = cell_width(ch)
            if used + cw > limit:
                break
            out, used = out + ch, used + cw
        try:
            self.scr.addstr(y, x, out, attr)
        except self.c.error:
            pass  # writing the bottom-right cell raises; harmless
        return x + used

    def draw(self) -> None:
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 6 or w < 30:
            self.put(0, 0, "barn: window too small")
            scr.refresh()
            return
        # header
        router = {None: "", True: " · router ●", False: " · router ○ (not running)"}[self.router_up]
        self.put(0, 0, " herdr-barn", self.HUMAN)
        self.put(0, 11, f" · {len(self.roster)} agents{router}", self.DIM)
        hint = "Tab @complete · PgUp/PgDn · Esc close "
        if w > 60:
            self.put(0, w - text_width(hint), hint, self.DIM)
        # roster strip
        x = 1
        for addr, agent in self.roster.items():
            label = f"{STATE_GLYPH.get(agent.get('status'), '?')} {display_addr(addr, self.roster)}  "
            if x + text_width(label) >= w:
                self.put(1, x, "…", self.DIM)
                break
            x = self.put(1, x, label, self.agent_attr(addr))
        # log
        top, bottom = 2, h - 3
        height = bottom - top + 1
        rows = self.build_lines(w - 1)
        max_scroll = max(0, len(rows) - height)
        self.scroll = min(self.scroll, max_scroll)
        start = max(0, len(rows) - height - self.scroll)
        for i, row in enumerate(rows[start:start + height]):
            x = 0
            for chunk, attr in row:
                x = self.put(top + i, x, chunk, attr)
        if not rows:
            self.put(top, 1, "The barn is quiet. Say something: @<box>/<pane> task…  or @all", self.DIM)
        # status line
        note = self.flash if time.time() < self.flash_until else ""
        if self.scroll:
            note = (note + "  " if note else "") + f"↑ scrolled {self.scroll} lines (PgDn)"
        self.put(h - 2, 0, "─" * w, self.DIM)
        if note:
            self.put(h - 2, 2, f" {note} ", self.SYS)
        # input
        prompt = "> "
        text = "".join(self.buf)
        before = text[:self.cur]
        avail = w - len(prompt) - 1
        shift = max(0, text_width(before) - avail)
        visible, skipped = "", 0
        for ch in text:
            if skipped < shift:
                skipped += cell_width(ch)
                continue
            visible += ch
        self.put(h - 1, 0, prompt, self.HUMAN)
        self.put(h - 1, len(prompt), visible)
        try:
            scr.move(h - 1, min(w - 1, len(prompt) + text_width(before) - shift))
        except self.c.error:
            pass
        scr.refresh()

    # input ----------------------------------------------------------------
    def say(self, message: str) -> None:
        if message == "/who":
            names = [f"@{a}" for a in self.roster] or ["(none)"]
            self.flash_msg("agents: " + " ".join(names), 8)
            return
        append_jsonl(OUTBOX, {"id": new_id(), "ts": now_iso(), "from": HUMAN, "text": message})
        self.history.append(message)
        self.hist_i = len(self.history)
        self.scroll = 0
        self.flash_msg("sent" if self.router_up is not False else "queued; router is not running")

    def flash_msg(self, text: str, secs: float = 3) -> None:
        self.flash, self.flash_until = text, time.time() + secs

    def complete(self) -> None:
        text = "".join(self.buf)
        head = text[:self.cur]
        m = re.search(r"@([\w:./-]*)$", head)
        if not m:
            return
        if self.comp and self.comp["end"] == self.cur and self.comp["options"]:
            comp = self.comp
            comp["i"] = (comp["i"] + 1) % len(comp["options"])
        else:
            prefix = m.group(1).lower()
            options = [HUMAN] + list(self.roster) + sorted(
                {a["name"] for a in self.roster.values() if a.get("name")}
            ) + ["all"]
            options = [o for o in options if o.lower().startswith(prefix)]
            if not options:
                self.flash_msg("no match")
                return
            comp = self.comp = {"start": m.start(), "options": options, "i": 0}
        choice = "@" + comp["options"][comp["i"]] + " "
        tail = text[self.cur:]
        new_head = text[:comp["start"]] + choice
        self.buf = list(new_head + tail)
        self.cur = len(new_head)
        comp["end"] = self.cur
        if len(comp["options"]) > 1:
            self.flash_msg(f"{comp['i'] + 1}/{len(comp['options'])} — Tab for next")

    def key(self, ch) -> bool:
        c = self.c
        h, _ = self.scr.getmaxyx()
        page = max(1, h - 6)
        if ch not in ("\t", c.KEY_RESIZE):
            self.comp = None
        if isinstance(ch, str):
            if ch in ("\n", "\r"):
                message = "".join(self.buf).strip()
                self.buf, self.cur = [], 0
                if message:
                    self.say(message)
            elif ch == "\t":
                self.complete()
            elif ch == "\x1b":
                if not self.buf:
                    return False
                self.buf, self.cur = [], 0
            elif ch in ("\x03", "\x04"):
                return False
            elif ch in ("\x7f", "\x08"):
                if self.cur:
                    del self.buf[self.cur - 1]
                    self.cur -= 1
            elif ch == "\x15":
                self.buf, self.cur = self.buf[self.cur:], 0
            elif ch == "\x17":
                i = self.cur
                while i and self.buf[i - 1] == " ":
                    i -= 1
                while i and self.buf[i - 1] != " ":
                    i -= 1
                del self.buf[i:self.cur]
                self.cur = i
            elif ch == "\x01":
                self.cur = 0
            elif ch == "\x05":
                self.cur = len(self.buf)
            elif ch.isprintable():
                self.buf.insert(self.cur, ch)
                self.cur += 1
            return True
        if ch in (c.KEY_BACKSPACE,):
            return self.key("\x7f")
        if ch == c.KEY_DC and self.cur < len(self.buf):
            del self.buf[self.cur]
        elif ch == c.KEY_LEFT:
            self.cur = max(0, self.cur - 1)
        elif ch == c.KEY_RIGHT:
            self.cur = min(len(self.buf), self.cur + 1)
        elif ch == c.KEY_HOME:
            self.cur = 0
        elif ch == c.KEY_END:
            self.cur = len(self.buf)
        elif ch == c.KEY_UP and self.history:
            self.hist_i = max(0, self.hist_i - 1)
            self.buf = list(self.history[self.hist_i])
            self.cur = len(self.buf)
        elif ch == c.KEY_DOWN and self.history:
            self.hist_i = min(len(self.history), self.hist_i + 1)
            self.buf = list(self.history[self.hist_i]) if self.hist_i < len(self.history) else []
            self.cur = len(self.buf)
        elif ch == c.KEY_PPAGE:
            self.scroll += page
        elif ch == c.KEY_NPAGE:
            self.scroll = max(0, self.scroll - page)
        return True

    def run(self) -> None:
        dirty = True
        while True:
            self.check_router()
            if self.poll():
                dirty = True
            if dirty or time.time() < self.flash_until + 0.3:
                self.draw()
                dirty = False
            try:
                ch = self.scr.get_wch()
            except self.c.error:
                continue
            except KeyboardInterrupt:
                return
            if not self.key(ch):
                return
            dirty = True


def cmd_ui(args) -> int:
    import curses
    import locale

    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    os.makedirs(BARN_DIR, exist_ok=True)
    if os.path.exists(HUB_MARKER) and not router_running():
        spawn_router()
    try:
        curses.wrapper(lambda scr: UI(scr).run())
    except KeyboardInterrupt:
        pass
    return 0


# ──────────────────────────────────── main ──────────────────────────────────


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="barn", description="herdr-barn: a chat room for your agents")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("say", help="post a message (@human, @<box>/<pane>, @name, @all)")
    p.add_argument("--human", action="store_true", help="post as @human even inside a pane")
    p.add_argument("text", nargs="+", help='message text, or "-" to read stdin')
    p.set_defaults(fn=cmd_say)
    p = sub.add_parser("log", help="print recent history")
    p.add_argument("-n", type=int, default=30)
    p.set_defaults(fn=cmd_log)
    sub.add_parser("who", help="list agents in the barn").set_defaults(fn=cmd_who)
    sub.add_parser("ui", help="open the room").set_defaults(fn=cmd_ui)
    p = sub.add_parser("router", help="deliver @mentions (hub only)")
    p.add_argument("--daemon", action="store_true", help="start in the background if not running")
    p.set_defaults(fn=cmd_router)
    args = parser.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
